{
  "name": "codegen-openapi",
  "version": "2.0.0",
  "description": "Zero-dependency CLI that generates Next.js route handlers, typed services, and React Query hooks from any OpenAPI/Swagger spec",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "openapi-gen": "./bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "axios": "^1.20.0",
    "esbuild": "^0.28.2",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitepress": "^1.6.4"
  },
  "keywords": [
    "nextjs",
    "react",
    "openapi",
    "swagger",
    "codegen",
    "cli",
    "routes",
    "services",
    "hooks",
    "react-query",
    "tanstack",
    "typescript"
  ],
  "author": "Miguel thelastcodee@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Last-Code-MgL/codegen-openapi.git"
  },
  "homepage": "https://github.com/Last-Code-MgL/codegen-openapi#readme",
  "bugs": {
    "url": "https://github.com/Last-Code-MgL/codegen-openapi/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
